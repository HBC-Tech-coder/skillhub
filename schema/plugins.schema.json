{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/HBC-Tech-coder/skillhub/main/schema/plugins.schema.json",
  "title": "SkillHub plugins.json / entry schema",
  "type": "object",
  "additionalProperties": true,
  "required": ["id", "name", "owner", "url", "category", "description", "install", "ecosystems", "added"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "owner": { "type": "string", "minLength": 1, "maxLength": 120 },
    "url": { "type": "string", "format": "uri" },
    "category": { "type": "string", "minLength": 1, "maxLength": 40 },
    "description": {
      "type": "object",
      "required": ["en", "zh"],
      "additionalProperties": true,
      "properties": {
        "en": { "type": "string", "maxLength": 400 },
        "zh": { "type": "string", "maxLength": 400 }
      }
    },
    "install": { "type": "string", "maxLength": 400 },
    "ecosystems": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind", "install"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 40 },
          "kind": { "type": "string", "enum": ["plugin", "skill", "server", "registry", "theme", "other"] },
          "install": { "type": "string", "maxLength": 400 }
        }
      }
    },
    "added": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "npm": { "type": ["string", "null"], "maxLength": 200 },
    "tarball": { "type": ["string", "null"], "format": "uri" },
    "stars": { "type": ["integer", "null"], "minimum": 0 },
    "downloads": { "type": ["integer", "null"], "minimum": 0 },
    "screenshots": { "type": "array", "items": { "type": "string", "format": "uri" } },
    "kind": { "type": "string", "enum": ["plugin", "skill", "server", "registry", "other"] },
    "license": { "type": "string", "maxLength": 64 },
    "author": { "type": "string", "maxLength": 120 },
    "tags": { "type": "array", "items": { "type": "string", "maxLength": 40 } },
    "verified": { "type": "boolean" },
    "status": { "type": "string", "enum": ["active", "archived", "pending"] },
    "page": { "type": ["string", "null"], "format": "uri" }
  }
}
